# ============================================================
# GICCA PERFUMES BOUTIQUE - VARIABLES DE ENTORNO
# ============================================================

# Servidor & Entorno
PORT=3001
NODE_ENV=production

# Seguridad & Panel Administrativo
# JWT_SECRET es obligatoria en producción (el servidor no arranca sin ella)
JWT_SECRET=tu_clave_secreta_jwt_criptografica_minimo_32_caracteres
# Contraseña inicial de la tienda principal (DEFAULT_TENANT) hasta que su dueño defina
# email y contraseña propios desde Admin > Mi Tienda > Acceso al Panel
ADMIN_PASSWORD=TuContraseñaSeguraAdmin2026!
DEFAULT_TENANT=gicca

# Superadmin de la plataforma (consola /superadmin: alta, baja y suspensión de perfumerías)
SUPERADMIN_EMAIL=vos@tuplataforma.com
SUPERADMIN_PASSWORD=UnaClaveLargaYDistintaALaDeLaTienda

# Cantidad de proxies delante del servidor (Render/Railway/Nginx = 1) para limitar intentos por IP real
TRUST_PROXY=1

# Mercado Pago
# URL pública del backend para las notificaciones (webhooks). Si se omite se usa el origen del navegador.
PUBLIC_API_URL=https://tutienda.com
# Clave secreta de webhooks (Tus integraciones > Webhooks) para validar la firma x-signature (opcional)
MP_WEBHOOK_SECRET=
# Horas que se espera un pago de Mercado Pago antes de cancelar el pedido y liberar el stock
MP_PENDING_ORDER_TTL_HOURS=72

# Base de Datos MongoDB Atlas (Requerido para producción)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/gicca_perfumes?retryWrites=true&w=majority

# Almacenamiento de Imágenes Cloudinary (Requerido para producción)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ============================================================
# INTEGRACIÓN LOGÍSTICA ANDREANI
# ============================================================
ANDREANI_SANDBOX=true
ANDREANI_USERNAME=
ANDREANI_PASSWORD=
ANDREANI_CLIENT_CODE=

ANDREANI_CONTRACT_DOMICILIO=400006709
ANDREANI_CONTRACT_SUCURSAL=400006710
ANDREANI_CONTRACT_URGENTE=400006711
ANDREANI_ORIGIN_ZIP=2400
FREE_SHIPPING_THRESHOLD=200000
