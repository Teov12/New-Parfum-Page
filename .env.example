# ============================================================
# PLATAFORMA DE PERFUMERÍAS - VARIABLES DE ENTORNO
# ============================================================

# Servidor & Entorno
PORT=3001
NODE_ENV=production
# Cantidad de proxies delante del servidor (Render/Railway/Nginx/Caddy = 1) para limitar intentos por IP real
TRUST_PROXY=1

# ------------------------------------------------------------
# PLATAFORMA (SaaS)
# ------------------------------------------------------------
PLATFORM_NAME=Perfumerías Online
# Dominio raíz: la landing vive en este dominio y cada tienda en <subdominio>.<PLATFORM_DOMAIN>
# Requiere un DNS comodín (*.tuplataforma.com) apuntando al servidor.
PLATFORM_DOMAIN=tuplataforma.com
# IP o host al que las tiendas apuntan su dominio propio (se muestra en el panel)
PLATFORM_DNS_TARGET=203.0.113.10
PLATFORM_SUPPORT_EMAIL=soporte@tuplataforma.com
TRIAL_DAYS=14
BILLING_GRACE_DAYS=5

# Precios mensuales de los planes (ARS) y límites
PLAN_BASIC_PRICE=19900
PLAN_PRO_PRICE=39900
PLAN_ENTERPRISE_PRICE=79900
PLAN_BASIC_PRODUCTS=150
PLAN_PRO_PRODUCTS=1000
# Comisión de la plataforma por venta con Mercado Pago (%), solo para tiendas conectadas por OAuth
PLAN_BASIC_COMMISSION=0
PLAN_PRO_COMMISSION=0
PLAN_ENTERPRISE_COMMISSION=0

# Cobro de suscripciones: Access Token de la cuenta de Mercado Pago del dueño de la plataforma.
# Configurá el webhook https://<PLATFORM_DOMAIN>/api/billing/webhook en Mercado Pago Developers
# (eventos "Planes y suscripciones").
PLATFORM_MP_ACCESS_TOKEN=

# Conexión de Mercado Pago en un clic (OAuth). Creá una aplicación en Mercado Pago Developers
# y registrá la URL de redirección exacta.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://tuplataforma.com/api/mercadopago/oauth/callback

# Clave para cifrar credenciales de las tiendas (tokens de MP, Andreani, ARCA).
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: si se pierde o se cambia, las credenciales guardadas dejan de poder leerse.
DATA_ENCRYPTION_KEY=

# ------------------------------------------------------------
# SEGURIDAD & PANEL
# ------------------------------------------------------------
# JWT_SECRET es obligatoria en producción (el servidor no arranca sin ella)
JWT_SECRET=tu_clave_secreta_jwt_criptografica_minimo_32_caracteres
# Tienda principal de la instalación (no paga suscripción) y su contraseña inicial,
# válida hasta que su dueño defina email y contraseña desde Admin > Mi Tienda > Acceso al Panel
DEFAULT_TENANT=gicca
ADMIN_PASSWORD=TuContraseñaSeguraAdmin2026!
# URL pública de la tienda principal (sitemap, emails, SEO)
SITE_URL=https://tutienda.com

# Superadmin de la plataforma (consola /superadmin: alta, baja y suspensión de perfumerías)
SUPERADMIN_EMAIL=vos@tuplataforma.com
SUPERADMIN_PASSWORD=UnaClaveLargaYDistintaALaDeLaTienda

# Documentación Swagger en /api/docs (deshabilitada en producción salvo que se active)
ENABLE_API_DOCS=false

# ------------------------------------------------------------
# MERCADO PAGO (tienda principal y webhooks)
# ------------------------------------------------------------
# Credenciales de respaldo SOLO para la tienda principal (las demás cargan las suyas en el panel)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# URL pública del backend para las notificaciones (webhooks). Si se omite se usa la URL de la tienda.
PUBLIC_API_URL=https://tuplataforma.com
# Clave secreta de webhooks (Tus integraciones > Webhooks) para validar la firma x-signature (opcional)
MP_WEBHOOK_SECRET=
# Horas que se espera un pago de Mercado Pago antes de cancelar el pedido y liberar el stock
MP_PENDING_ORDER_TTL_HOURS=72

# ------------------------------------------------------------
# EMAILS TRANSACCIONALES
# ------------------------------------------------------------
# Recomendado: Resend con un dominio de envío verificado (los emails salen con el nombre de cada tienda)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=pedidos@tuplataforma.com
# Alternativa: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Avisos de venta de la tienda principal si no cargó un email en el panel
STORE_ADMIN_EMAIL=
# Horas que se espera antes de enviar el recordatorio de carrito abandonado
ABANDONED_CART_DELAY_HOURS=2

# ------------------------------------------------------------
# BASE DE DATOS & ARCHIVOS
# ------------------------------------------------------------
# MongoDB es obligatorio para tener varias tiendas (sin él funciona como una sola tienda)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/perfumerias?retryWrites=true&w=majority

# Almacenamiento de Imágenes Cloudinary (Requerido para producción)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ------------------------------------------------------------
# ANDREANI (cuenta de la tienda principal; las demás cargan la suya en el panel)
# ------------------------------------------------------------
ANDREANI_SANDBOX=true
ANDREANI_USERNAME=
ANDREANI_PASSWORD=
ANDREANI_CLIENT_CODE=

ANDREANI_CONTRACT_DOMICILIO=400006709
ANDREANI_CONTRACT_SUCURSAL=400006710
ANDREANI_CONTRACT_URGENTE=400006711
ANDREANI_ORIGIN_ZIP=2400
# Respaldo si la tienda no configuró su monto de envío gratis
FREE_SHIPPING_THRESHOLD=200000
